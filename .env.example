# Password for the web UI. Required when the harness is reachable from the internet.
ADMIN_PASSWORD=
# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# FreeLLMAPI (default provider). The unified key is on the Keys page of its dashboard.
FREELLMAPI_ENCRYPTION_KEY=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

# Optional: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Pick a ":free" model; "openrouter/auto" can route to paid models.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Roko's Carnival address, included in every agent's environment prompt.
ROKOS_CARNIVAL_URL=

# Host ports (docker compose). The harness UI, and FreeLLMAPI's dashboard on localhost.
HARNESS_PORT=8082
FREELLMAPI_DASHBOARD_PORT=3002

# These seed settings on first boot only; after that, change them in the Settings page.
